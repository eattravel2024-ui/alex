{
  "name": "health-association-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "dev:setup": "node scripts/dev-setup.mjs",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:migrate:local": "node --experimental-wasm-modules scripts/prisma-migrate-wasm.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node scripts/seed.mjs",
    "db:backup": "node scripts/db-backup.mjs backup",
    "db:restore:local": "node scripts/db-backup.mjs restore-if-empty",
    "db:backup:verify": "node scripts/db-backup.mjs verify",
    "dev:admin": "node scripts/dev-admin.mjs",
    "db:verify:cms": "node scripts/verify-cms-schema.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.7",
    "dotenv": "^18.0.7",
    "next": "16.4.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@prisma/client-generator-ts": "7.10.0",
    "@prisma/driver-adapter-utils": "7.10.0",
    "@prisma/internals": "7.10.0",
    "@prisma/schema-engine-wasm": "7.10.0-4.0edf323efd1d98336f3f0a68684b56f689b900d3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "type": "module",
  "overrides": {
    "mysql2": "3.24.5",
    "deepmerge-ts": "8.0.2"
  }
}
