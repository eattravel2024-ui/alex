# Documentation only. For local development run npm run dev:setup; do not copy
# this file over the generated .env.local or replace existing backup keys.
# No credentials belong in Git. Supply production values through secure runtime settings.
DATABASE_URL=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
DEVELOPMENT_MODE=false
POLICIES_APPROVED=false
POLICY_VERSION=
MEMBERSHIP_APPLICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Local-only password and AES-256-GCM key are generated by development helpers.
DEV_DATABASE_PASSWORD=
DEV_BACKUP_KEY=
# Optional confirmed HTTPS origin. Rebuild after SEO changes.
APP_URL=
SITE_INDEXING_ENABLED=false

# Enable only after event rules and runtime are approved; local setup enables demo booking.
EVENT_REGISTRATIONS_ENABLED=false
CONTACT_SUBMISSIONS_ENABLED=false
