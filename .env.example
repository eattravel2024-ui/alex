# Phase 2 本地開發不需要秘密值。SEO 設定變更後必須重新 build。
# APP_URL 必須是已確認的 HTTPS origin（無 credentials/path/query）。
# 未提供 APP_URL 時不產生 canonical 或 sitemap URLs。
# APP_URL=https://your-confirmed-domain
SITE_INDEXING_ENABLED=false

# 以下資料庫／認證／SMTP 設定保留供 Phase 3 使用，尚未讀取。
# DATABASE_URL=postgresql://user:password@db:5432/health
# AUTH_SECRET=generate-secure-random-value
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
